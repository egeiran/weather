{
  "name": "weather-layers",
  "version": "0.1.0",
  "private": true,
  "description": "MapLibre layers for value-encoded weather tiles: colour field, arrows, particles, point series, thresholds.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts",
    "./messages/nb.json": "./src/i18n/nb.json",
    "./messages/en.json": "./src/i18n/en.json",
    "./styles.css": "./src/react/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "maplibre-gl": "^6.8.0",
    "react": "^19.0.0",
    "react-map-gl": "^8.1.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-map-gl": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "maplibre-gl": "^6.8.0",
    "react": "^19.3.0",
    "react-map-gl": "^8.1.3",
    "vitest": "^5.1.2"
  }
}
