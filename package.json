{
  "name": "weather-layers-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "web/layer",
    "web/demo"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev -w web/demo",
    "build": "npm run build -w web/layer && npm run build -w web/demo",
    "typecheck": "npm run typecheck -w web/layer && npm run typecheck -w web/demo",
    "lint": "eslint web && prettier --check \"web/**/*.{ts,tsx,json,css,md}\"",
    "format": "prettier --write \"web/**/*.{ts,tsx,json,css,md}\"",
    "test": "npm run test -w web/layer",
    "screenshots": "playwright test -c web/demo/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.65.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
